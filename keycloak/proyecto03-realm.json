{
  "realm": "proyecto03",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "ADMIN"
      },
      {
        "name": "USER"
      }
    ]
  },
  "clients": [
    {
      "clientId": "payments-cli",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "payments-api-scope",
        "payments:read"
      ],
      "optionalClientScopes": [
        "payments:write"
      ]
    },
    {
      "clientId": "payments-machine",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "GENERATE_AT_DEPLOYMENT",
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "payments-api-scope",
        "payments:read",
        "payments:write"
      ],
      "optionalClientScopes": []
    }
  ],
  "clientScopes": [
    {
      "name": "payments-api-scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-payments-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "payments-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "payments:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "payments:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ]
}
